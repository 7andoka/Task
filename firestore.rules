rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading user profiles for login check (needed for getUserByUsername)
    match /users/{username} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }

    // Allow everything else if authenticated
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
