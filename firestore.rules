rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users {
      allow list: if request.auth != null;
      match /{userId} {
        allow get: if true;
        allow write: if request.auth != null;
      }
    }

    // Allow everything else if authenticated
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
