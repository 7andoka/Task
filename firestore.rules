rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.displayName is string &&
             data.role is string;
    }

    function isValidTask(data) {
      return data.id is string &&
             data.title is string &&
             data.status is string &&
             data.priority is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Public access as requested to bypass Firebase Auth
    // WARNING: This is insecure and should be hardened with custom auth logic if possible.
    match /{document=**} {
      allow read, write: if true;
    }

    // Validation for specific collections
    match /users/{userId} {
      allow create, update: if isValidUser(request.resource.data);
    }

    match /tasks/{taskId} {
      allow create, update: if isValidTask(request.resource.data);
    }
  }
}
