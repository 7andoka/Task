{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Warehouse Manager", "Department Head", "Supervisor", "Warehouse Specialist", "Warehouse Keeper", "Assistant Warehouse Keeper", "Worker"] },
        "managerId": { "type": "string" },
        "department": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "needsPasswordChange": { "type": "boolean" },
        "initialPassword": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Warehouse task information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Urgent"] },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Pending Review", "Delayed", "Completed", "Cancelled"] },
        "deadline": { "type": "string", "format": "date-time" },
        "estimatedTime": { "type": "number" },
        "actualTimeSpent": { "type": "number" },
        "progress": { "type": "number" },
        "assigneeId": { "type": "string" },
        "managerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "priority", "status", "deadline", "assigneeId", "managerId", "createdAt"]
    },
    "Subtask": {
      "title": "Subtask",
      "description": "Task sub-item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "title": { "type": "string" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["id", "taskId", "title", "isCompleted"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Task comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "taskId", "userId", "userName", "text", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "type", "isRead", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "action", "details", "createdAt"]
    },
    "BarrelMovement": {
      "title": "BarrelMovement",
      "description": "Barrel movement log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "barrelType": { "type": "string", "enum": ["سنابل", "البرتغاليه", "وطنيه"] },
        "ownership": { "type": "string", "enum": ["ملكي", "ملك المورد"] },
        "quantity": { "type": "number" },
        "movementType": { "type": "string", "enum": ["Receipt", "Dispatch"] },
        "movementTime": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "supplierId", "barrelType", "ownership", "quantity", "movementType", "movementTime", "createdAt", "lastUpdatedAt"]
    }
  },
  "firestore": {
    "users": { "schema": "UserProfile", "description": "User profiles collection" },
    "tasks": { "schema": "Task", "description": "Tasks collection" },
    "subtasks": { "schema": "Subtask", "description": "Subtasks collection" },
    "comments": { "schema": "Comment", "description": "Comments collection" },
    "notifications": { "schema": "Notification", "description": "Notifications collection" },
    "audit_logs": { "schema": "AuditLog", "description": "Audit logs collection" },
    "barrel_movements": { "schema": "BarrelMovement", "description": "Barrel movements collection" }
  }
}
